---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocaleStaticPaths } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { getPostsBySeries } from "@/lib/content";
import TitleList from "@/components/TitleList.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = getMessages(locale);
const quantPosts = getPostsBySeries(locale, "quant-trading");
---

<BaseLayout
  description={t.pages.quant.description}
  title={`${t.pages.quant.title} - ${t.site.title}`}
>
  <div class="mb-8">
    <h1 class="mb-4 text-3xl font-bold">{t.pages.quant.title}</h1>
    <p class="text-gray-600">{t.pages.quant.introduction}</p>
  </div>
  <TitleList posts={quantPosts} />
</BaseLayout>
