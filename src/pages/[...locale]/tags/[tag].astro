---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TitleList from "@/components/TitleList.astro";
import { locales } from "@/i18n/config";
import { getLocale, getLocalePath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { getPostsByTag } from "@/lib/content";

export async function getStaticPaths() {
  return locales.flatMap((locale) =>
    [...getPostsByTag(locale)].map(([tag, posts]) => ({
      params: { locale: getLocalePath(locale), tag },
      props: { posts },
    })),
  );
}

const { tag } = Astro.params;
const { posts: curPosts } = Astro.props;
const locale = getLocale(Astro.params.locale);
const t = getMessages(locale);
---

<BaseLayout
  description={`${t.pages.tags.description}: ${tag}`}
  title={`${tag} - ${t.pages.tags.title}`}
>
  <h2 class="mb-8 text-xl">{t.labels.tag}: {tag}</h2>
  <TitleList posts={curPosts} />
</BaseLayout>
