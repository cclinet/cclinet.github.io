---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocaleStaticPaths, getLocalizedPath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { getTagSummaries } from "@/lib/content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;
const { locale } = Astro.props;
const t = getMessages(locale);
const tags = getTagSummaries(locale);
---

<BaseLayout
  description={t.pages.tags.description}
  title={`${t.pages.tags.title} - ${t.site.title}`}
>
  <h2 class="mb-8 text-xl">{t.pages.tags.title}</h2>
  <ul class="grid grid-cols-2 gap-4">
    {
      tags.map(({ tag, count }) => (
        <li class="text-zinc-900">
          <a class="underline" href={getLocalizedPath(locale, `/tags/${tag}`)}>
            {tag}: {count}
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
