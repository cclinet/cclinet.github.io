---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLocaleStaticPaths, getLocalizedPath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { getPostsByYear } from "@/lib/content";
import FormattedDate from "@/components/FormattedDate.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = getMessages(locale);
const postsByYear = getPostsByYear(locale);
const years = [...postsByYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  description={t.pages.archives.description}
  title={`${t.pages.archives.title} - ${t.site.title}`}
>
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-8 text-3xl font-bold">{t.pages.archives.title}</h1>

    <div class="flex flex-col gap-8">
      {
        years.map((year) => (
          <section>
            <h2 class="mb-4 border-b pb-2 text-2xl font-bold text-gray-800">
              {year}
            </h2>
            <ul class="flex flex-col gap-4">
              {postsByYear.get(year)!.map((post) => (
                <li class="group flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
                  <a
                    href={getLocalizedPath(locale, `/posts/${post.slug}/`)}
                    class="text-lg font-medium text-gray-900 transition-colors hover:text-blue-600"
                  >
                    {post.data.title}
                  </a>
                  <div class="text-sm whitespace-nowrap text-gray-500">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
