---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";
import { getLocaleStaticPaths } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { getMathPostsByCategory } from "@/lib/content";

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = getMessages(locale);
const postsByCategory = getMathPostsByCategory(locale);
---

<BaseLayout
  description={t.pages.math.description}
  title={`${t.pages.math.title} - ${t.site.title}`}
>
  <div>{t.pages.math.introduction}</div>
  {
    [...postsByCategory].map(([category, posts]) => (
      <>
        <h2>{category}</h2>
        <div class="flex flex-col">
          {posts.map((post) => (
            <a href={`${post.category}/${post.slug}/`}>{post.data.title}</a>
          ))}
        </div>
      </>
    ))
  }
</BaseLayout>
