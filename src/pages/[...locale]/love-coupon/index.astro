---
import { getLocaleStaticPaths } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import type { GetStaticPaths } from "astro";
import BaseHead from "@/components/BaseHead.astro";

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;

const locale = Astro.props.locale;
const t = getMessages(locale);
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <BaseHead
      description={t.pages.loveCoupon.title}
      title={t.pages.loveCoupon.title}
    />
  </head>
  <body>
    <div class="flex h-dvh flex-col bg-rose-50">
      <div
        class="h-h-full mx-auto my-auto flex h-1/3 w-xl flex-col items-center justify-center gap-y-4 rounded-4xl border-4 border-dashed bg-white"
      >
        <h1 class="text-3xl text-rose-500">{t.pages.loveCoupon.title}</h1>
        <div class="pt-4 text-rose-300">{t.pages.loveCoupon.recipient}</div>
        <div class="bg-rose-400 text-white">{t.pages.loveCoupon.benefit}</div>
        <div>
          <h2 class="text-amber-400">{t.pages.loveCoupon.termsHeading}</h2>
          {t.pages.loveCoupon.terms}
        </div>
        <p class="flex w-full px-2 text-gray-300">
          <span>{t.pages.loveCoupon.expiryLabel}</span>
          <span>{t.pages.loveCoupon.expiry}</span>
          <span class="grow"></span>
          <span class="justify-self-end">No. 5201314</span>
        </p>
      </div>
    </div>
  </body>
</html>
