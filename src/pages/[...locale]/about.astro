---
import { getLocaleStaticPaths } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";

const tools: { link: string; content: string; description: string }[] = [
  {
    link: "https://astro.build",
    content: "astro.js",
    description: "Website Framework",
  },
  {
    link: "https://tailwindcss.com",
    content: "tailwindcss",
    description: "Styling Library",
  },
  {
    link: "https://katex.org",
    content: "katex",
    description: "Mathematical Formulas",
  },
  {
    link: "https://unifiedjs.com",
    content: "unifiedjs",
    description: "Markdown Rendering",
  },
  {
    link: "https://expressive-code.com",
    content: "expressive-code",
    description: "Code Blocks",
  },
];

export const getStaticPaths = (() =>
  getLocaleStaticPaths()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const t = getMessages(locale);
---

<BaseLayout description={t.pages.about.description} title={t.pages.about.title}>
  <article class="leading-relaxed">
    <h2 class="mb-4 text-2xl">{t.pages.about.introductionHeading}</h2>
    <p>{t.pages.about.introduction}</p>
  </article>
  <hr class="my-8" />
  <h2 class="mb-4 text-2xl">{t.pages.about.siteHeading}</h2>
  <section>
    <h3 class="mt-2 text-xl">{t.pages.about.stackHeading}</h3>
    <ul>
      {
        tools.map(({ link, content, description }) => (
          <li class="underline">
            <a href={link}>
              {content} - {description}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <div class="mt-4">
    <p>
      {t.pages.about.sourceCodeLead}
      <a class="underline" href="https://github.com/cclinet/cclinet.github.io"
        >github</a
      >.
    </p>
    <p>
      {t.pages.about.deploymentLead}
      <a class="underline" href="https://www.cloudflare.com/zh-cn/"
        >cloudflare page</a
      >.
    </p>

    <hr class="my-8" />
    <h2 class="mb-4 text-2xl">{t.pages.about.contactHeading}</h2>
    <ul class="pb-6">
      <li>matrix: @cclinet:nya.one</li>
      <li>Email: me@cclin.org</li>
      <li>Guestbook: https://github.com/cclinet/cclinet.github.io/issues</li>
    </ul>
  </div>
</BaseLayout>
