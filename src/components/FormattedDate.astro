---
interface Props {
  date: Date;
}

const { date } = Astro.props;
const locale = Astro.currentLocale === "zh" ? "zh-CN" : "en-US";
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  }
</time>
