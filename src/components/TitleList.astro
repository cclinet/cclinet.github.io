---
import { getLocale, getLocalizedPath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import type { BlogPost } from "@/lib/content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:ml-10 lg:grid-cols-3">
  {
    posts.map((post, index) => {
      const isFeatured = index === 0;
      const spanClass = isFeatured
        ? "md:col-span-2 md:row-span-2 md:min-h-72"
        : "col-span-1";
      const visibleTags = post.data.tags?.slice(0, 2) ?? [];
      const remainingTagCount =
        (post.data.tags?.length ?? 0) - visibleTags.length;

      return (
        <article
          class:list={[
            "group relative flex min-h-40 flex-col justify-between overflow-hidden rounded-2xl border border-zinc-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg hover:shadow-zinc-200/60 sm:p-6",
            spanClass,
          ]}
        >
          <a
            href={getLocalizedPath(locale, `/posts/${post.slug}/`)}
            class="absolute inset-0 z-10"
          >
            <span class="sr-only">
              {t.labels.viewPost}: {post.data.title}
            </span>
          </a>
          <div>
            <h3
              class:list={[
                "leading-tight font-bold text-zinc-900 transition-colors group-hover:text-blue-600",
                isFeatured ? "text-2xl md:text-3xl" : "text-xl",
              ]}
            >
              {post.data.title}
            </h3>
            <p
              class:list={[
                "mt-3 line-clamp-2 leading-relaxed text-zinc-600",
                isFeatured ? "max-w-2xl text-base" : "text-sm",
              ]}
            >
              {post.data.description}
            </p>
          </div>
          <div class="mt-6 flex flex-wrap items-end justify-between gap-3">
            <div class="flex flex-wrap gap-1.5" aria-label={t.labels.tag}>
              {visibleTags.map((tag) => (
                <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs text-zinc-600">
                  {tag}
                </span>
              ))}
              {remainingTagCount > 0 && (
                <span class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs text-zinc-500">
                  +{remainingTagCount}
                </span>
              )}
            </div>
            <div class="text-sm whitespace-nowrap text-zinc-500">
              <FormattedDate date={post.data.pubDate} />
            </div>
          </div>
        </article>
      );
    })
  }
</div>
