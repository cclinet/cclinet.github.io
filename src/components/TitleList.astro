---
import { getLocale, getLocalizedPath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import type { BlogPost } from "@/lib/content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:ml-10 lg:grid-cols-3">
  {
    posts.map((post, index) => {
      const isFeatured = index === 0;
      const spanClass = isFeatured
        ? "md:col-span-2 md:row-span-2"
        : "col-span-1";

      return (
        <article
          class:list={[
            "group relative flex flex-col justify-between overflow-hidden rounded-xl border border-gray-200 bg-white p-6 transition-all hover:shadow-lg",
            spanClass,
          ]}
        >
          <a
            href={getLocalizedPath(locale, `/posts/${post.slug}/`)}
            class="absolute inset-0 z-10"
          >
            <span class="sr-only">
              {t.labels.viewPost}: {post.data.title}
            </span>
          </a>
          <div class="mb-4">
            <h3 class="text-xl leading-tight font-bold text-gray-900 group-hover:text-blue-600">
              {post.data.title}
            </h3>
          </div>
          <div class="mt-auto flex items-center justify-between text-sm text-gray-500">
            <FormattedDate date={post.data.pubDate} />
          </div>
        </article>
      );
    })
  }
</div>
