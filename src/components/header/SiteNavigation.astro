---
import { getLocale, getLocalizedPath } from "@/i18n/utils";
import { getMessages } from "@/i18n/messages";
import { NAVIGATION_GROUPS, SOCIAL_LINKS } from "@/config/site";
import Github from "@/svgs/github.svg";
import Rss from "@/svgs/rss.svg";
import Travellings from "@/svgs/travellings.svg";
import Zhihu from "@/svgs/zhihu.svg";
const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);

const socialIcons = {
  rss: Rss,
  github: Github,
  zhihu: Zhihu,
  travellings: Travellings,
};
---

<nav class="text-center font-bold">
  <ul class="flex flex-col gap-0 text-left lg:items-start lg:gap-4">
    {
      NAVIGATION_GROUPS.map((group) => (
        <li class="flex flex-col gap-1">
          <h3 class="nav-group-trigger text-sm font-bold tracking-wider text-gray-500 uppercase lg:pointer-events-none">
            {t.navigation.groups[group.label]}
          </h3>

          <ul class="hidden flex-col gap-1 pl-2 lg:flex">
            {group.items.map(({ label, href }) => (
              <li class="transition-colors hover:text-blue-600">
                <a
                  href={getLocalizedPath(locale, href)}
                  class="block py-0 text-base font-medium text-gray-900"
                >
                  {t.navigation.items[label]}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</nav>

<ul class="flex flex-row justify-center gap-1 lg:justify-start">
  {
    SOCIAL_LINKS.map(({ id, href, external }) => {
      const Icon = socialIcons[id];
      const url = external ? href : getLocalizedPath(locale, href);

      return (
        <li>
          <a
            aria-label={id}
            class="inline-flex items-center"
            href={url}
            rel={external ? "noopener noreferrer" : undefined}
            target={external ? "_blank" : undefined}
          >
            <Icon width={24} height={24} />
          </a>
        </li>
      );
    })
  }
</ul>
<script>
  function initNav() {
    const triggers = document.querySelectorAll(".nav-group-trigger");

    // 2. 遍历每一个触发器
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        // 3. 找到这个标题对应的下一个兄弟元素 (即 ul 列表)
        const content = trigger.nextElementSibling!;

        // 5. 切换显隐 Class
        // toggle('hidden') 会在 hidden 存在时删除它，不存在时添加它
        content.classList.toggle("hidden");
        content.classList.toggle("flex"); // 确保显示时有 flex 布局
      });
    });
  }
  initNav();
  document.addEventListener("astro:page-load", initNav);
</script>
