---
import { getLocale, getLocalizedPath } from "@/i18n/utils";
import { locales } from "@/i18n/config";
import ZH from "@/svgs/zh.svg";
import EN from "@/svgs/en.svg";

const icons = { zh: ZH, en: EN };
const languages = locales.map((locale) => ({ locale, icon: icons[locale] }));
const currentLocale = getLocale(Astro.currentLocale);
const regex = new RegExp(`^/${currentLocale}`);
const currentUrlWithoutLocale = Astro.url.pathname.replace(regex, "");
---

<div
  class="flex justify-end gap-1 rounded-md lg:order-4 lg:justify-start"
  role="group"
>
  {
    languages.map(({ locale, icon: Icon }) => (
      <a
        aria-label={locale}
        class="text-sm font-medium"
        href={getLocalizedPath(locale, currentUrlWithoutLocale)}
      >
        <Icon
          class="h-5 lg:h-6"
          class:list={{ "cursor-default": currentLocale === locale }}
          width={24}
          height={24}
        >
          {locale}
        </Icon>
      </a>
    ))
  }
</div>
