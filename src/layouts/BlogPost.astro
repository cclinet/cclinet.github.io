---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";
import { getLocalizedPath } from "@/i18n/utils";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & { locale: Locale };

const { title, description, pubDate, updatedDate, tags, locale } = Astro.props;
const t = getMessages(locale);
---

<BaseLayout description={description} title={title}>
  <article class="mx-auto max-w-4xl">
    <h1
      class="text-3xl leading-tight font-bold text-balance sm:text-4xl lg:text-center"
    >
      {title}
    </h1>
    <div
      class="mt-4 flex flex-wrap justify-between gap-x-6 gap-y-2 text-sm text-zinc-500"
    >
      <FormattedDate date={pubDate} />
      {
        updatedDate && (
          <div>
            {t.labels.lastUpdated} <FormattedDate date={updatedDate} />
          </div>
        )
      }
    </div>
    <div class="mt-3 flex flex-wrap gap-2 text-sm text-zinc-600">
      {
        tags?.map((tag) => (
          <a
            class="rounded-full bg-zinc-100 px-2.5 py-1 transition-colors hover:bg-blue-50 hover:text-blue-700"
            href={getLocalizedPath(locale, `/tags/${tag}`)}
          >
            {tag}
          </a>
        ))
      }
    </div>

    <hr class="my-6 border-zinc-200" />

    <div class="mx-auto prose mt-8 mb-10 prose-zinc" id="content">
      <slot />
    </div>
  </article>
</BaseLayout>
