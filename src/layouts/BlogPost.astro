---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { getMessages } from "@/i18n/messages";
import { getLocalizedPath } from "@/i18n/utils";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";

type Props = CollectionEntry<"blog">["data"] & { locale: Locale };

const { title, description, pubDate, updatedDate, tags, locale } = Astro.props;
const t = getMessages(locale);
---

<BaseLayout description={description} title={title}>
  <article>
    <h1 class="w-full text-center text-4xl">{title}</h1>
    <div class="mt-3 flex justify-between text-sm">
      <FormattedDate date={pubDate} />
      {
        updatedDate && (
          <div>
            {t.labels.lastUpdated} <FormattedDate date={updatedDate} />
          </div>
        )
      }
    </div>
    <div class="flex gap-x-4 text-sm text-zinc-500">
      {
        tags?.map((tag) => (
          <a href={getLocalizedPath(locale, `/tags/${tag}`)}>{tag}</a>
        ))
      }
    </div>

    <hr />

    <div class="mx-auto prose mt-8 mb-10 prose-zinc" id="content">
      <slot />
    </div>
  </article>
</BaseLayout>
